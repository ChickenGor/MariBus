rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.subscriptionPlan == 'free'
        && request.resource.data.subscriptionEnd == null;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.subscriptionPlan == resource.data.subscriptionPlan
        && request.resource.data.subscriptionEnd == resource.data.subscriptionEnd;
      allow delete: if false;
    }
  }
}
