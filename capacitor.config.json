{
  "appId": "com.chickenrice.maribus",
  "appName": "MariBus",
  "webDir": "www",
  "server": {
    "url": "https://mari-bus.vercel.app/",
    "errorPath": "offline.html",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "adjustMarginsForEdgeToEdge": "force"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": ["google.com"]
    }
  }
}
